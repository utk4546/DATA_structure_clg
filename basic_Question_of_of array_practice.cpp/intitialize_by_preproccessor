#include <iostream>
using namespace std;

#define n 3
#define m 3

int main(){
    int a[n][m];

    cout<<"Enter the elements of matrix:\n";
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cin>>a[i][j];
        }
    }

    cout<<"Matrix is:\n";
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cout<<a[i][j]<<" ";
        }
        cout<<endl;
    }

    cout<<"done";
    return 0;
}
